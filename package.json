{
  "name": "react-pdf-highlighter",
  "version": "7.1.3",
  "description": "Set of React components for PDF annotation (Confido fork: pdfjs-dist 6.x support, rotated-page highlight fix)",
  "author": "Artem Tyurin <artem.tyurin@gmail.com>",
  "license": "MIT",
  "keywords": [
    "pdf",
    "highlight",
    "annotator",
    "react-component"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "(cd ./example && vite)",
    "build": "npm run clean && npm run build:esm && npm run build:copy-styles",
    "build:esm": "tsc",
    "build:copy-styles": "cp -r ./src/style ./dist",
    "build:example": "(cd ./example && tsc && vite build)",
    "test": "tsc && npm run lint && npm run test:e2e",
    "test:e2e": "playwright test",
    "format": "biome format --write",
    "lint": "biome check",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "pdfjs-dist": "^6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "debounce": "^3.0.0",
    "react-rnd": "^10.5.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Confido-Repo/react-pdf-highlighter.git"
  },
  "bugs": {
    "url": "https://github.com/Confido-Repo/react-pdf-highlighter/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "pdfjs-dist": "6.1.200",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
